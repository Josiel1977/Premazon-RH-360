'use client';

import { ReactNode } from 'react';
import Link from 'next/link';
import { usePathname } from 'next/navigation';
import { 
  LayoutDashboard, 
  GraduationCap, 
  ShieldCheck, 
  Users, 
  Target, 
  Award,
  LogOut,
  Settings
} from 'lucide-react';

const navItems = [
  { name: 'Dashboard', href: '/dashboard', icon: LayoutDashboard },
  { name: 'Universidade Corporativa', href: '/dashboard/treinamentos', icon: GraduationCap },
  { name: 'Segurança & NRs', href: '/dashboard/seguranca', icon: ShieldCheck },
  { name: 'Recrutamento', href: '/dashboard/recrutamento', icon: Users },
  { name: 'Desempenho & PDI', href: '/dashboard/desempenho', icon: Target },
  { name: 'Liderança', href: '/dashboard/lideranca', icon: Award },
];

export default function DashboardLayout({ children }: { children: ReactNode }) {
  const pathname = usePathname();

  return (
    <div className="h-screen bg-[#F8F9FA] flex flex-col overflow-hidden font-sans text-[#1A1A1A]">
      {/* Top Header */}
      <header className="h-[80px] shrink-0 border-b border-gray-200 flex items-center justify-between px-10 bg-white">
        <div className="font-black text-2xl tracking-tight text-[#00468C]">
          PREMAZON <span className="font-light text-gray-500">RH 360</span>
        </div>
        <div className="hidden md:flex text-[10px] uppercase tracking-widest bg-sky-50 text-sky-700 px-3 py-1 rounded-full font-bold items-center gap-1.5">
          <span className="w-1.5 h-1.5 bg-sky-500 rounded-full"></span>
          MFA Ativo: j.silva@premazon.com.br
        </div>
        <button className="md:hidden text-gray-400 hover:text-gray-900">
          <LayoutDashboard className="w-6 h-6" />
        </button>
      </header>

      <div className="flex flex-1 min-h-0">
        {/* Sidebar */}
        <aside className="w-[240px] border-r border-gray-200 bg-white py-10 flex flex-col justify-between hidden md:flex shrink-0">
          <nav className="flex-1 space-y-1">
            {navItems.map((item) => {
              const isActive = pathname === item.href;
              const Icon = item.icon;
              
              return (
                <Link
                  key={item.name}
                  href={item.href}
                  className={`flex items-center gap-3 px-10 py-3 text-[13px] uppercase tracking-wider font-semibold cursor-pointer transition-colors ${
                    isActive 
                      ? 'text-gray-900 border-l-4 border-[#00468C] bg-gradient-to-r from-gray-100 to-transparent' 
                      : 'text-gray-500 hover:bg-gray-50 hover:text-gray-900 border-l-4 border-transparent'
                  }`}
                >
                  {/* Assuming they want minimal icons or no icons based on the HTML, but let's keep icons small */}
                  <Icon className={`w-4 h-4 ${isActive ? 'text-[#00468C]' : 'text-gray-400'}`} />
                  {item.name}
                </Link>
              );
            })}
          </nav>

          <div className="px-10 mt-auto pt-6">
            <div className="text-[11px] text-gray-400 leading-relaxed">
              v1.4.2 CORPORATE<br/>
              2024 © Premazon S/A
            </div>
            <Link
              href="/"
              className="mt-6 flex items-center gap-2 text-[11px] font-bold text-gray-400 hover:text-gray-900 transition-colors uppercase tracking-wider"
            >
              <LogOut className="w-3.5 h-3.5" />
              Sair da Conta
            </Link>
          </div>
        </aside>

        {/* Main Content */}
        <main className="flex-1 overflow-auto p-4 md:p-10 bg-[#F8F9FA]">
          {children}
        </main>
      </div>
    </div>
  );
}
