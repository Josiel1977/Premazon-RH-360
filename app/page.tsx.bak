'use client';

import { useState } from 'react';
import { useRouter } from 'next/navigation';
import { ShieldAlert, Lock, ArrowRight, Building } from 'lucide-react';

export default function LoginPage() {
  const router = useRouter();
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [error, setError] = useState('');

  const handleLogin = (e: React.FormEvent) => {
    e.preventDefault();
    setError('');

    // Validação de acesso (Mock para demonstração)
    const isAdmin = email === 'josiel@jmeletroservice.com.br' && password === 'Admin1677@';
    const isCorporate = email.endsWith('@premazon.com.br') && password.length > 0;

    if (!isAdmin && !isCorporate) {
      setError('Credenciais inválidas ou e-mail não autorizado.');
      return;
    }

    // Em produção, isso integraria com Supabase Auth
    // Redirecionando para o dashboard para fins de visualização
    router.push('/dashboard');
  };

  return (
    <div className="min-h-screen bg-[#F8F9FA] flex flex-col items-center justify-center p-4">
      <div className="w-full max-w-[400px]">
        <div className="mb-10 text-center">
          <div className="font-black text-2xl tracking-tight text-[#00468C] mb-2">
            PREMAZON <span className="font-light text-gray-500">RH 360</span>
          </div>
          <h1 className="font-serif italic text-3xl text-gray-900 mt-4 leading-none">Acesso Corporativo</h1>
        </div>

        <div className="bg-white border border-gray-200 p-8 shadow-sm">
          <form onSubmit={handleLogin} className="space-y-6">
            <div>
              <label htmlFor="email" className="block text-[10px] uppercase tracking-widest font-bold text-gray-500 mb-2">
                E-mail Corporativo
              </label>
              <div className="relative">
                <input
                  id="email"
                  type="email"
                  value={email}
                  onChange={(e) => setEmail(e.target.value)}
                  placeholder="nome@premazon.com.br"
                  className="w-full bg-[#F8F9FA] border border-gray-200 px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:border-[#00468C] transition-colors text-sm"
                  required
                />
              </div>
            </div>

            <div>
              <label htmlFor="password" className="block text-[10px] uppercase tracking-widest font-bold text-gray-500 mb-2">
                Senha
              </label>
              <div className="relative">
                <input
                  id="password"
                  type="password"
                  value={password}
                  onChange={(e) => setPassword(e.target.value)}
                  placeholder="••••••••"
                  className="w-full bg-[#F8F9FA] border border-gray-200 px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:border-[#00468C] transition-colors text-sm"
                  required
                />
              </div>
            </div>

            {error && (
              <div className="flex items-start gap-2 text-red-700 bg-red-50 p-3 text-xs border border-red-200">
                <ShieldAlert className="w-4 h-4 shrink-0" />
                <p>{error}</p>
              </div>
            )}

            <button
              type="submit"
              className="w-full bg-[#00468C] hover:bg-blue-900 text-white text-[11px] font-bold uppercase tracking-widest py-4 transition-colors flex items-center justify-center gap-2"
            >
              Entrar <ArrowRight className="w-4 h-4" />
            </button>
          </form>
        </div>
        
        <div className="mt-8 flex items-center justify-center gap-2 text-gray-400 text-[10px] uppercase tracking-widest font-bold">
          <Lock className="w-3 h-3" />
          <span>Acesso monitorado. Protegido por MFA.</span>
        </div>
      </div>
    </div>
  );
}
