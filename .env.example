# Supabase: copie os valores em Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-publicavel

# Somente no servidor. Necessária para receber candidaturas e guardar currículos privados.
# Supabase > Project Settings > API Keys > Secret keys.
# Nunca use NEXT_PUBLIC_ neste nome e nunca envie esta chave ao GitHub.
SUPABASE_SECRET_KEY=sua-chave-secreta

# Opcional: habilitar somente quando os recursos de IA forem implementados no servidor.
GEMINI_API_KEY=
